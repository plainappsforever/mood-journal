<?xml version="1.0" encoding="utf-8"?>
<!-- P9 "Mood" widget (MoodWidgetProvider). RemoteViews-safe views only. Five faces (each opens the editor with that
     level), a status line (today + streak, or just "Mood" while the app lock is on). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mood_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mood_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mood_widget_face_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/mood_widget_face_0_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/mood_widget_face_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/mood_widget_face_0_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🙂"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mood_widget_face_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/mood_widget_face_1_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/mood_widget_face_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/mood_widget_face_1_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🙂"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mood_widget_face_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/mood_widget_face_2_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/mood_widget_face_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/mood_widget_face_2_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🙂"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mood_widget_face_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/mood_widget_face_3_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/mood_widget_face_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/mood_widget_face_3_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🙂"
                android:textSize="22sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mood_widget_face_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/mood_widget_face_4_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/mood_widget_face_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/mood_widget_face_4_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🙂"
                android:textSize="22sp" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mood_widget_today"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/mood_widget_face_bg"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/mood_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mood"
            android:textColor="#D0D4DA"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- P9: 4 x 1 row of five faces with a streak line. updatePeriodMillis 0: the app pushes changes, an inexact RTC
     alarm redraws at the next journal-day start (MoodWidgetProvider). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/mood_widget_description"
    android:initialLayout="@layout/mood_widget"
    android:previewLayout="@layout/mood_widget"
    android:minWidth="300dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
